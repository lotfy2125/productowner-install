{
	# Let's Encrypt writes here about expiring certificates (optional).
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000
}

# The meetings address (written by install.sh when meetings are on).
import /etc/caddy/sites/*.caddy
