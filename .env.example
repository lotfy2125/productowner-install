# ProductOwner install settings. ./install.sh fills this in; edit and run `docker compose up -d` to apply.

# Where people open ProductOwner (a DNS name pointing at this server).
DOMAIN=productowner.example.com
# Email for Let's Encrypt notices about the HTTPS certificate.
ACME_EMAIL=admin@example.com

# Which ProductOwner to run.
PRODUCTOWNER_IMAGE=ghcr.io/lotfy2125/productowner
PRODUCTOWNER_VERSION=0.1.0

# Secrets: long random values (install.sh makes them). Keep a copy somewhere safe, apart from the backups:
# PO_SECRET unlocks the tokens saved in the database.
POSTGRES_PASSWORD=
PO_SECRET=

# Meetings (video, screen share, recording). Remove "meetings" to switch them off.
COMPOSE_PROFILES=meetings
# A second DNS name for the video server, pointing at this same server.
MEET_DOMAIN=meet.productowner.example.com
LIVEKIT_PUBLIC_URL=wss://meet.productowner.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email (invitations, password resets, meeting invitations and recaps). Without it, emails go to the app log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=ProductOwner <noreply@example.com>

# PO agent with Claude (drafts stories and meeting recaps). Without a key, built-in rules do.
# ANTHROPIC_API_KEY=sk-ant-...

# Phone and desktop notifications: made once by the app if empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
